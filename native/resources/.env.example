# browser-mcp configuration
# Copy to .env and customize

# Port for MCP HTTP transport
BROWSER_MCP_PORT=10780

# Bind host
BROWSER_MCP_HOST=127.0.0.1

# Browser automation
BROWSER_HEADLESS=true

# Agentic browsing (browser-use) + chat
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:12b

# Optional: comma-separated upstream MCP servers to proxy
# MCP_BRIDGE_URLS=http://127.0.0.1:10946/mcp
